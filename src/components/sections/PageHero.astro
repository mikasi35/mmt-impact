---
import Plate from '@components/media/Plate.astro';
import type { PlateVariant, PlateTone } from '@lib/plates';

interface Props {
  eyebrow: string;
  /** Authored line breaks — the display type is a compositional element. */
  lines: string[];
  lede?: string;
  /** Small key/value rail beneath the title, e.g. Sector / Status / Location. */
  facts?: { label: string; value: string }[];
  seed: string;
  /** Real photograph, when one exists for this page. */
  src?: string;
  variant?: PlateVariant;
  tone?: PlateTone;
  surface?: 'dark' | 'forest';
  size?: 'default' | 'compact' | 'tall';
  actions?: { label: string; href: string; style?: 'accent' | 'ghost' }[];
}

const {
  eyebrow,
  lines,
  lede,
  facts = [],
  seed,
  src,
  variant,
  tone = 'navy',
  surface = 'dark',
  size = 'default',
  actions = [],
} = Astro.props;
---

<section class={`phero surface-${surface} phero--${size}`} data-parallax-scope>
  <div class="phero__media">
    <Plate seed={seed} src={src} variant={variant} tone={tone} ratio="fill" priority parallax={6} alt="" />
    <div class="phero__scrim" aria-hidden="true"></div>
  </div>

  <div class="wrap phero__inner">
    <p class="t-meta phero__eyebrow" data-reveal>
      <span class="phero__eyebrow-rule" aria-hidden="true"></span>
      {eyebrow}
    </p>

    <h1 class="phero__heading reveal-lines" data-reveal="lines">
      {
        lines.map((l) => (
          <span>
            <span>{l}</span>
          </span>
        ))
      }
    </h1>

    {lede && <p class="t-lead phero__lede" data-reveal>{lede}</p>}

    {
      actions.length > 0 && (
        <div class="phero__actions" data-reveal>
          {actions.map((a) => (
            <a class={`btn ${a.style === 'ghost' ? 'btn--ghost' : 'btn--accent'}`} href={a.href}>
              {a.label}
              <span class="btn-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      )
    }

    {
      facts.length > 0 && (
        <dl class="phero__facts" data-reveal>
          {facts.map((f) => (
            <div>
              <dt class="t-meta">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(3.5rem, 9vw, 8rem) clamp(2.5rem, 6vw, 5rem);
  }

  .phero--compact {
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .phero--tall {
    padding-block: clamp(5rem, 13vw, 12rem) clamp(3rem, 7vw, 6rem);
  }

  .phero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .phero__media :global(.plate),
  .phero__media :global(.frame) {
    height: 100%;
  }

  .phero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgb(7 24 39 / 0.95) 26%, rgb(7 24 39 / 0.7) 100%),
      linear-gradient(to top, rgb(7 24 39 / 0.85), rgb(7 24 39 / 0.1) 60%);
  }

  .surface-forest .phero__scrim {
    background:
      linear-gradient(105deg, rgb(16 31 23 / 0.95) 26%, rgb(16 31 23 / 0.68) 100%),
      linear-gradient(to top, rgb(16 31 23 / 0.85), rgb(16 31 23 / 0.1) 60%);
  }

  .phero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--accent);
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .phero__eyebrow-rule {
    width: clamp(1.5rem, 4vw, 3rem);
    height: 1px;
    background: currentColor;
  }

  .phero__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-display);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: #fff;
    max-width: 20ch;
  }

  .phero--compact .phero__heading {
    font-size: var(--text-h1);
  }

  .phero__lede {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 58ch;
    color: #b9c8d2;
  }

  .phero__actions {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .phero__facts {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    border-top: 1px solid color-mix(in srgb, #fff 18%, transparent);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.25rem clamp(1.5rem, 4vw, 3rem);
  }

  .phero__facts > div {
    display: grid;
    gap: 0.35rem;
  }

  .phero__facts dt {
    color: color-mix(in srgb, #fff 48%, transparent);
  }

  .phero__facts dd {
    margin: 0;
    font-size: 0.9375rem;
    color: #e2e9ed;
    line-height: 1.3;
  }
</style>
