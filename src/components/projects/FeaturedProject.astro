---
import type { CollectionEntry } from 'astro:content';
import SectionLabel from '@components/typography/SectionLabel.astro';
import Plate from '@components/media/Plate.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: string;
}

const { project, index = '06' } = Astro.props;
const d = project.data;

const STATUS_LABEL: Record<string, string> = {
  active: 'Active',
  'in-design': 'In design',
  planned: 'Planned',
  completed: 'Completed',
};

const period = [d.startDate?.getFullYear(), d.endDate?.getFullYear()].filter(Boolean).join('–');

const facts = [
  { label: 'Sector', value: 'Education & Skills' },
  { label: 'Status', value: STATUS_LABEL[d.status] ?? d.status },
  {
    label: 'Beneficiaries',
    value: d.beneficiaries === null ? 'In reporting' : d.beneficiaries.toLocaleString('en-GB'),
  },
  { label: 'Period', value: period || 'To be confirmed' },
];
---

<section class="fproj surface-light section" aria-labelledby="fproj-heading" data-parallax-scope>
  <div class="wrap">
    <SectionLabel index={index} label="Featured Project" meta={d.location} />
  </div>

  <div class="fproj__layout">
    <!-- Media breaks the container to the left edge: an art-directed asymmetry. -->
    <div class="fproj__media">
      <Plate
        seed={`featured-${project.id}`}
        src="/images/index/06-Featured-Project.jpg"
        variant={d.media?.variant}
        tone={d.media?.tone ?? 'navy'}
        ratio="wide"
        parallax={7}
        caption={d.media?.caption}
        alt={d.title}
      />
    </div>

    <div class="fproj__body">
      <h2 class="t-h1 fproj__title" id="fproj-heading" data-reveal>{d.title}</h2>
      <p class="t-lead fproj__summary" data-reveal>{d.summary}</p>

      <dl class="fproj__facts" data-reveal>
        {
          facts.map((f) => (
            <div>
              <dt class="t-meta">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <a class="btn btn--ghost fproj__cta" href={`/impact/projects/${project.id}`} data-reveal>
        View project
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .fproj__layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .fproj__layout {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    /* Bleed the media to the viewport edge rather than the container edge. */
    .fproj__media {
      margin-left: calc(-1 * max(calc((100vw - var(--container-max)) / 2), var(--spacing-gutter)));
    }

    .fproj__body {
      padding-right: max(calc((100vw - var(--container-max)) / 2), var(--spacing-gutter));
    }
  }

  @media (max-width: 63.999rem) {
    .fproj__body {
      padding-inline: var(--spacing-gutter);
    }
  }

  .fproj__summary {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    max-width: 46ch;
  }

  .fproj__facts {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem clamp(1.5rem, 3vw, 2.5rem);
  }

  .fproj__facts > div {
    display: grid;
    gap: 0.35rem;
  }

  .fproj__facts dt {
    color: var(--ink-faint);
  }

  .fproj__facts dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-strong);
  }

  .fproj__cta {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }
</style>
