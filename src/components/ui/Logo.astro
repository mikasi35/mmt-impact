---
/**
 * MMT Impact lockup — the real brand mark, not a drawn placeholder.
 *
 * Three pre-cropped, alpha-transparent PNGs (public/images/logo/, cut from
 * the supplied mmt-impact-logo.png and favicon.jpg) cover every usage:
 *   - `mark`     icon alone, for tight/compact placements.
 *   - `full`     icon + "MMT IMPACT" wordmark, for the header (default).
 *   - `full` + `strapline`   icon + wordmark + "Building Stronger
 *                Communities.", for the footer and print covers.
 * Transparency means all three sit cleanly on any surface colour.
 */
interface Props {
  /** `full` = mark + wordmark. `mark` = mark only. */
  variant?: 'full' | 'mark';
  /** Swaps in the mark+wordmark+tagline asset. Footer and print covers only. */
  strapline?: boolean;
  class?: string;
  /** Rendered height in px; width follows the asset's own aspect ratio. */
  size?: number;
}

const ASSET = {
  mark: { src: '/images/logo/mark.png', ratio: 237 / 234 },
  full: { src: '/images/logo/mark-wordmark.png', ratio: 406 / 294 },
  strapline: { src: '/images/logo/full-lockup.png', ratio: 406 / 325 },
} as const;

const { variant = 'full', strapline = false, class: className = '', size = 34 } = Astro.props;

const chosen = variant === 'mark' ? ASSET.mark : strapline ? ASSET.strapline : ASSET.full;
const width = Math.round(size * chosen.ratio);
---

<span class={`logo ${className}`} data-variant={variant}>
  <img
    class="logo__img"
    src={chosen.src}
    width={width}
    height={size}
    alt="MMT Impact"
    decoding="async"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  /* No width/height rules here — the computed HTML attributes above are the
     real sizing. Any CSS auto/percent value on this element would win over
     them and render the source PNG at its native (much larger) resolution. */
  .logo__img {
    display: block;
  }
</style>
