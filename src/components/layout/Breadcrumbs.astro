---
import type { Crumb } from '@lib/seo';

interface Props {
  crumbs: Crumb[];
  surface?: 'light' | 'dark';
}

const { crumbs, surface = 'light' } = Astro.props;
---

<nav class={`crumbs crumbs--${surface}`} aria-label="Breadcrumb">
  <div class="wrap">
    <ol>
      <li>
        <a class="t-meta" href="/">Home</a>
      </li>
      {
        crumbs.map((c, i) => (
          <li>
            <span class="crumbs__sep t-meta" aria-hidden="true">
              /
            </span>
            {i === crumbs.length - 1 ? (
              <span class="t-meta crumbs__current" aria-current="page">
                {c.label}
              </span>
            ) : (
              <a class="t-meta" href={c.href}>
                {c.label}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .crumbs {
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
  }

  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0.9rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 0.55rem;
  }

  .crumbs li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .crumbs a {
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 180ms var(--ease-institutional);
  }

  .crumbs a:hover {
    color: var(--accent-ink);
  }

  .crumbs__sep {
    color: var(--ink-faint);
    opacity: 0.5;
  }

  .crumbs__current {
    color: var(--ink-strong);
  }
</style>
