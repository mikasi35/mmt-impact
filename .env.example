# ---------------------------------------------------------------------------
# MMT Impact — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Canonical site origin (no trailing slash). Used for sitemap, canonicals, OG.
PUBLIC_SITE_URL="https://www.mmtimpact.org"

# Where enquiry / partnership / careers forms POST.
# Leave blank to fall back to a client-side mail-draft handoff (no backend).
# Recommended for launch: a server endpoint or a vetted form service.
PUBLIC_FORM_ENDPOINT=""

# Privacy-conscious analytics (e.g. Plausible / Fathom / Umami). Leave blank to disable.
PUBLIC_ANALYTICS_DOMAIN=""
PUBLIC_ANALYTICS_SRC=""

# Optional: MapLibre vector-tile basemap. The site ships with a keyless,
# self-contained GeoJSON basemap and does NOT require this.
PUBLIC_MAP_STYLE_URL=""
